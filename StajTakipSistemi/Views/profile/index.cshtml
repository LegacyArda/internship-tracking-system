@model StajTakipSistemi.Models.ogrenci

@{
    ViewData["Title"] = "Profilim";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5 text-center">
                    <div class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center mb-4" style="width: 100px; height: 100px; font-size: 2.5rem;">
                        👤
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Profil Bilgileri</h3>
                    <p class="text-muted mb-4 font-monospace" style="font-size: 0.9rem;">@User.Identity?.Name</p>
                    <hr />

                    @if (ViewBag.Role == "Akademisyen" || ViewBag.Role == "Yönetici")
                    {
                        <div class="text-start mt-4 bg-light p-3 rounded-3 shadow-sm">
                            <p class="mb-2"><strong>E-Posta:</strong> @ViewBag.Email</p>
                            <p class="mb-0"><strong>Yetki Durumu:</strong> <span class="badge bg-danger px-2 py-1 rounded-pill">@ViewBag.Role</span></p>
                        </div>
                    }
                    else if (Model != null)
                    {
                        <div class="text-start mt-4 bg-light p-3 rounded-3 shadow-sm">
                            <p class="mb-2"><strong>Ad Soyad:</strong> @Model.FirstName @Model.LastName</p>
                            <p class="mb-2"><strong>Öğrenci Numarası:</strong> @Model.StudentNumber</p>
                            <p class="mb-2"><strong>Bölüm:</strong> @Model.Department</p>
                            <p class="mb-2"><strong>E-Posta:</strong> @Model.Email</p>
                            <p class="mb-0"><strong>Sistem Rolü:</strong> <span class="badge bg-success px-2 py-1 rounded-pill">Öğrenci</span></p>
                        </div>
                    }
                    else
                    {
                        <div class="text-start mt-4 bg-light p-3 rounded-3 shadow-sm text-center">
                            <p class="mb-2"><strong>Hesap Türü:</strong> <span class="badge bg-warning text-dark px-2 py-1 rounded-pill">Öğrenci</span></p>
                            <div class="alert alert-info mt-3 mb-0" style="font-size: 0.85rem;">
                                Öğrenci detay bilgileriniz (Ad, Soyad, Numara) henüz veritabanındaki öğrenciler tablosuna eklenmemiş. Bilgileriniz tanımlandığında burada görünecektir.
                            </div>
                        </div>
                    }

                    <hr class="mt-4" />
                    <a href="/" class="btn btn-outline-primary rounded-pill px-4 mt-2 shadow-sm">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>