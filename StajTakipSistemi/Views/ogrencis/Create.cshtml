@model StajTakipSistemi.Models.ogrenci

@{
    ViewData["Title"] = "Yeni Öğrenci Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Yeni Öğrenci Kaydı</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Adını giriniz" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="LastName" class="form-label fw-bold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Soyadını giriniz" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="StudentNumber" class="form-label fw-bold"></label>
                            <input asp-for="StudentNumber" class="form-control" placeholder="10 haneli numara" />
                            <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Department" class="form-label fw-bold"></label>
                            <input asp-for="Department" class="form-control" placeholder="Bölümünü yazınız" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="ogrenci@okul.edu.tr" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Kaydet</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}