@model StajTakipSistemi.Models.InternshipReport

@{
    ViewData["Title"] = "Yeni Rapor Oluştur";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-5">
                <h3 class="fw-bold text-primary mb-4"><i class="bi bi-file-earmark-plus"></i> Yeni Staj Raporu Gönder</h3>
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Title" class="form-control" placeholder="Başlık" />
                        <label asp-for="Title">Rapor Başlığı</label>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Date" type="date" class="form-control" />
                        <label asp-for="Date">Rapor / Staj Tarihi</label>
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Content" class="form-control" style="height: 150px" placeholder="İçerik"></textarea>
                        <label asp-for="Content">Staj Notları / Rapor İçeriği</label>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-4 bg-light p-3 rounded-3 border">
                        <label asp-for="UploadFile" class="form-label fw-bold text-dark">Ek Dosya Yükle (PDF/Word)</label>
                        <input asp-for="UploadFile" class="form-control" type="file" />
                        <small class="text-muted mt-1 d-block">Zorunlu değildir, eğer imzalı bir belgeniz varsa buraya yükleyebilirsiniz.</small>
                    </div>

                    @* SADECE HOCALAR ONAY TİKİNİ VE ÖĞRENCİ SEÇİMİNİ GÖREBİLİR *@
                    @if (User.IsInRole("Akademisyen") || User.IsInRole("Yönetici"))
                    {
                        <div class="alert alert-warning mb-4 rounded-3 border-0">
                            <h6 class="fw-bold"><i class="bi bi-shield-lock"></i> Yönetici Alanı</h6>
                            <div class="form-check form-switch mb-3">
                                <input asp-for="IsApproved" class="form-check-input" type="checkbox" style="transform: scale(1.3); margin-left: -2.5em;">
                                <label asp-for="IsApproved" class="form-check-label ms-2 fw-bold text-dark">Doğrudan Onaylı Olarak Kaydet</label>
                            </div>
                            <div class="mb-2">
                                <label asp-for="StudentId" class="form-label fw-bold text-dark">Raporun Ekleneceği Öğrenci</label>
                                <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId"></select>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm fw-bold">Gönder</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}